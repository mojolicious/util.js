{
  "name": "@mojojs/util",
  "version": "1.6.7",
  "description": "Utilities for mojo.js packages",
  "keywords": [
    "mojojs",
    "utils"
  ],
  "author": "Sebastian Riedel <kraih@mojolicious.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojolicious/util.js.git"
  },
  "bugs": {
    "url": "https://github.com/mojolicious/util.js/issues"
  },
  "homepage": "https://mojojs.org",
  "scripts": {
    "build": "npx tsc -p tsconfig.json",
    "check": "npx tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf lib",
    "coverage": "tap build && c8 tap --disable-coverage --allow-empty-coverage test/*.js",
    "coverage:ci": "tap build && c8 --reporter lcovonly tap --disable-coverage --allow-empty-coverage test/*.js",
    "lint": "eslint",
    "lint:fix": "npm run lint -- --fix",
    "prepublishOnly": "npm run clean && npm run build",
    "publish:minor": "npm version minor && npm publish",
    "publish:patch": "npm version patch && npm publish",
    "test": "tap build && tap --disable-coverage --allow-empty-coverage test/*.js",
    "check:package": "sh test/support/package/check.sh"
  },
  "exports": "./lib/util.js",
  "types": "./lib/util.d.ts",
  "type": "module",
  "files": [
    "lib/"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tap": "^21.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "engines": {
    "node": ">= 22.18"
  },
  "tap": {
    "plugin": [
      "!@tapjs/typescript"
    ]
  }
}
